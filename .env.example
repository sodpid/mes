# 新环境请优先运行 npm run env:init 自动生成独立随机密码。
DATABASE_URL=mysql://mes_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:13379/mes_local_bigint
MYSQL_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ROOT_PASSWORD
# 仅供本地隔离测试建库/清理使用；应用只使用 DATABASE_URL。
MYSQL_ADMIN_URL=mysql://root:REPLACE_WITH_ROOT_PASSWORD@127.0.0.1:13379/mes_local_bigint
API_PORT=18080
WEB_ORIGIN=http://127.0.0.1:18080
