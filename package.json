{
  "name": "mes",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "start": "npm start -w apps/api",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:create-admin": "tsx scripts/admin.ts",
    "db:seed:demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "env:init": "node scripts/setup-env.mjs",
    "format": "prettier --write apps scripts tests *.ts *.json compose.yaml"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "concurrently": "9.2.5",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "dotenv": "17.2.3"
  }
}
